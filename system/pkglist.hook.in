# Installed to /etc/pacman.d/hooks/dotfiles-pkglist.hook by bootstrap.sh.
# @USER@ and @DOTFILES@ are filled in at install time.
[Trigger]
Operation = Install
Operation = Remove
Type = Package
Target = *

[Action]
Description = Updating dotfiles package lists...
When = PostTransaction
Exec = /usr/bin/runuser -u @USER@ -- @DOTFILES@/pkglist/update.sh
